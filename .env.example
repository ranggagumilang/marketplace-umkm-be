# backend/.env.example (JANGAN commit .env ke git!)
NODE_ENV=development
PORT=5000

# Database (PostgreSQL — Neon)
DATABASE_URL=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# JWT (GENERATE ULANG dengan crypto.randomBytes(32).toString('hex'))
JWT_SECRET=your_jwt_secret_min_32_characters_here
JWT_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Frontend URL (untuk CORS)
CLIENT_URL=http://localhost:5173
